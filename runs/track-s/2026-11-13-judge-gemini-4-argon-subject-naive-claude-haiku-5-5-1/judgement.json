 "items": [
  {
   "id": "DR-01",
   "requirement": "The service must keep each customer company's fleet, jobs, sites, pilots, flight records, and problems separate from every other customer company, so that no customer can view or query another customer's data, except the shared airspace information described in DR-02.",
   "read": "DR-01"
  },
  {
   "id": "DR-02",
   "requirement": "The service may share airspace information across all customer companies, and it must show that information to every customer identically, because the information comes from the authorities and is the same for everyone.",
   "read": "DR-02"
  },
  {
   "id": "DR-03",
   "requirement": "The service must not select which drone flies a job, which pilot or crew is assigned, or which route a flight takes; a dispatcher must make and record each of these choices.",
   "read": "DR-03"
  },
  {
   "id": "DR-04",
   "requirement": "The service must not approve a flight by itself; a flight may depart only after a dispatcher in the owning company has signed it off in the service.",
   "read": "DR-04"
  },
  {
   "id": "DR-05",
   "requirement": "The service must record who signed off each flight, when, and what the sign-off was based on, and must keep that record so it can be retrieved later by the owning company.",
   "read": "DR-05"
  },
  {
   "id": "DR-06",
   "requirement": "The service must not offer any control that steers a drone in flight; in-flight supervision must happen through each company's own autopilot and ground supervision, and the service must not sit in that control path.",
   "read": "DR-06"
  },
  {
   "id": "DR-07",
   "requirement": "The service must not manage, schedule, or allocate charging pads or other charging equipment belonging to a customer company, and must not show one customer's charging equipment or its usage to any other customer.",
   "read": "DR-07"
  },
  {
   "id": "DR-08",
   "requirement": "The service must allow a customer company to see only its own sites, and must not reveal the location or activity of another customer's sites, even where the sites overlap in the same airspace.",
   "read": "DR-08"
  },
  {
   "id": "DR-09",
   "requirement": "The service must let a customer company administer which of its own staff hold the dispatcher, technician, and airspace desk roles, and must not let a user act in a role that has not been granted to them by their own company.",
   "read": "DR-09"
  },
  {
   "id": "DR-10",
   "requirement": "The service must not give any customer company's staff, or the platform operator, the ability to read another customer's job, pilot, or fleet data by default, and any access granted across companies must be explicit, recorded, and revocable by the owning company.",
   "read": "DR-10"
  },
  {
   "id": "DR-11",
   "requirement": "The service must show each user the airspace information relevant to their own company's flights before a flight is signed off, and must show that information with its source and time of issue.",
   "read": "DR-11"
  },
  {
   "id": "DR-12",
   "requirement": "The service must keep a complete record of changes to flight plans, sign-offs, and staff role assignments, so that the owning company can establish what was done, by whom, and when.",
   "read": "DR-12"
  },
  {
   "id": "DR-13",
   "requirement": "The service must not use one customer company's data to inform, rank, or influence the decisions shown to another customer company, other than through the shared airspace information.",
   "read": "DR-13"
  },
  {
   "id": "DR-14",
   "requirement": "The service must support new customer companies joining the platform without changing the behaviour or data of existing customer companies.",
   "read": "DR-14"
  }
 ],
