 "items": [
  {
   "id": "DR-01",
   "requirement": "The service must not select which drone flies a job, and must not choose or generate a flight route. A licensed dispatcher makes both decisions for each flight, and the service only records and presents them.",
   "read": "DR-01"
  },
  {
   "id": "DR-02",
   "requirement": "The service must not allow a flight to be launched unless a named dispatcher has signed it off. A sign-off must record who signed, when, and for which drone, job, and route.",
   "read": "DR-02"
  },
  {
   "id": "DR-03",
   "requirement": "The service must let a dispatcher cancel or abort a flight at any time, including while it is in the air, and must record who did so, when, and why.",
   "read": "DR-03"
  },
  {
   "id": "DR-04",
   "requirement": "The service must show a dispatcher, before sign-off, the information the dispatcher needs to make the flight decision. The exact set of information must be confirmed with the customer companies' dispatchers before build, and each item must be listed in the requirements.",
   "read": "DR-04"
  },
  {
   "id": "DR-05",
   "requirement": "The service must keep each customer company's fleet, jobs, sites, incidents, and operating records visible only to users of that company. No user of one customer company may see another customer company's fleet, jobs, sites, or problems.",
   "read": "DR-05"
  },
  {
   "id": "DR-06",
   "requirement": "The service must not allow any platform staff member to view a customer company's operational data unless that company has granted access, and every such access must be logged.",
   "read": "DR-06"
  },
  {
   "id": "DR-07",
   "requirement": "The service must provide a shared airspace picture that all customer companies see identically. The shared picture must not reveal any customer company's flights, drones, jobs, or sites.",
   "read": "DR-07"
  },
  {
   "id": "DR-08",
   "requirement": "The service must show the shared airspace picture as it stands at the moment a flight is signed off, and must warn the signing dispatcher if the picture changes after sign-off and before launch or during flight.",
   "read": "DR-08"
  },
  {
   "id": "DR-09",
   "requirement": "The service must send each customer company's own systems the events for its drones and jobs, such as flight launched, flight aborted, and flight completed, so that billing and customer-update systems stay current. Events from one company must never be sent to another company.",
   "read": "DR-09"
  },
  {
   "id": "DR-10",
   "requirement": "The service must record every flight event in a log that cannot be edited or deleted by any user, and that is kept for a period confirmed with the customer companies and their regulators before build.",
   "read": "DR-10"
  },
  {
   "id": "DR-11",
   "requirement": "The service must not allow a drone to be shown as fit to fly unless its fault status and the checks required by the customer company's own procedures are recorded as complete. The exact checks must be confirmed with the technicians before build.",
   "read": "DR-11"
  },
  {
   "id": "DR-12",
   "requirement": "The service must let a technician take a drone out of service and must prevent any flight sign-off for that drone until a record shows it has been returned to service by a named person.",
   "read": "DR-12"
  },
  {
   "id": "DR-13",
   "requirement": "The service must let each customer company set its own users, roles, and permissions within that company, and must not allow one company's administrators to change another company's settings.",
   "read": "DR-13"
  },
  {
   "id": "DR-14",
   "requirement": "The service must work with the three roles: fleet technician, dispatcher, and airspace desk. Each role must see only the functions and data it needs for its work.",
   "read": "DR-14"
  }
 ],
