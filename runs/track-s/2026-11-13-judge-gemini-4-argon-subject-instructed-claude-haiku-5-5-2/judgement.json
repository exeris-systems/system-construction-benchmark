 "items": [
  {
   "id": "DR-01",
   "requirement": "The service must hold a shared picture of the airspace that includes the network of flight corridors between sites, the zones that group those corridors, and the closures announced by the authorities.",
   "read": "DR-01"
  },
  {
   "id": "DR-02",
   "requirement": "The service must record each closure as either planned, with a start time and an end time, or sudden, applying immediately on entry.",
   "read": "DR-02"
  },
  {
   "id": "DR-03",
   "requirement": "The service must let the airspace desk amend an existing closure, including widening its area and moving its end time, and must record when each amendment was made.",
   "read": "DR-03"
  },
  {
   "id": "DR-04",
   "requirement": "The service must update the shared picture when a closure is entered or amended during the day, not only when it is first entered.",
   "read": "DR-04"
  },
  {
   "id": "DR-05",
   "requirement": "The service must make a closure that comes into force, or is amended, while drones are airborne visible to the dispatcher responsible for each affected flight at the time of the change.",
   "read": "DR-05"
  },
  {
   "id": "DR-06",
   "requirement": "The service must not choose a drone, choose a route, or sign off a flight on a dispatcher's behalf; the responsible dispatcher must make and sign off each of these decisions.",
   "read": "DR-06"
  },
  {
   "id": "DR-07",
   "requirement": "The service must record, for each flight plan, the drone, the route, and the dispatcher who is responsible for the flight.",
   "read": "DR-07"
  },
  {
   "id": "DR-08",
   "requirement": "The service must allow a dispatcher to call off a flight.",
   "read": "DR-08"
  },
  {
   "id": "DR-09",
   "requirement": "The service must allow several dispatchers to plan flights at the same time for the same sites and the same drones without one dispatcher's change silently overwriting another's.",
   "read": "DR-09"
  },
  {
   "id": "DR-10",
   "requirement": "The service must show the airspace desk, when a closure is entered, a measure of how much disruption that closure caused across all customer companies; the definition of \"disruption\" must be agreed with the airspace desk before this measure is built.",
   "read": "DR-10"
  },
  {
   "id": "DR-11",
   "requirement": "The service must not show the airspace desk the operational details of any single customer company; cross-customer disruption must be shown only in aggregate.",
   "read": "DR-11"
  },
  {
   "id": "DR-12",
   "requirement": "The service must let a technician add a drone to the fleet and retire a drone from the fleet.",
   "read": "DR-12"
  },
  {
   "id": "DR-13",
   "requirement": "The service must let a technician record each drone's status as in service, out of service for repair, or sent to charge, and must let the technician change that status, including returning a drone to service.",
   "read": "DR-13"
  },
  {
   "id": "DR-14",
   "requirement": "The service must let a technician add and record charging pads at each site.",
   "read": "DR-14"
  }
 ],
